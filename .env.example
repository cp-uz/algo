# Production editor service. Copy to .env and replace placeholders.
CPUZ_ENV=production
CPUZ_PUBLIC_URL=https://algo-editor.cp.uz
CPUZ_DATABASE_PATH=/data/proposals.sqlite3
CPUZ_COOKIE_SECURE=true
CPUZ_SESSION_HOURS=24

CPUZ_GITHUB_CLIENT_ID=replace-me
CPUZ_GITHUB_CLIENT_SECRET=replace-me
CPUZ_GITHUB_TOKEN=replace-me
# Use a separate cryptographically random value of at least 32 bytes.
CPUZ_GITHUB_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
CPUZ_GITHUB_REPOSITORY=cp-uz/algo
CPUZ_GITHUB_BASE_BRANCH=main
CPUZ_APPLY_MODE=github_pr

CPUZ_MODERATOR_GITHUB_LOGINS=moderator-login
CPUZ_REVIEWER_GITHUB_LOGINS=
CPUZ_CONTRIBUTOR_GITHUB_LOGINS=
CPUZ_ALLOWED_GITHUB_ORG=

CPUZ_AUTO_BUILD=false
CPUZ_ALLOW_SELF_APPROVAL=false
CPUZ_MAX_PROPOSAL_BYTES=524288
CPUZ_MAX_WEBHOOK_BYTES=2097152
CPUZ_SUBMISSIONS_PER_HOUR=12
CPUZ_APPROVAL_CLAIM_TIMEOUT_MINUTES=15
